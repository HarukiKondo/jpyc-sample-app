# Sepolia Testnet Configuration
# Copy this to .env.local for Sepolia deployment

# Blockchain Configuration
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Contract Addresses
NEXT_PUBLIC_JPYC=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29
NEXT_PUBLIC_GATEWAY=YOUR_DEPLOYED_GATEWAY_ADDRESS_HERE
NEXT_PUBLIC_MERCHANT_ADDRESS=0x47e98DA2D8FA38ea76bBDbD1d3E2725732cb3A88

# Deployment Configuration (for deployment only)
PRIVATE_KEY=your_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: Infura/Alchemy Configuration
INFURA_API_KEY=your_infura_key_here
ALCHEMY_API_KEY=your_alchemy_key_here
